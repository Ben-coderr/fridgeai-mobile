# ─────────────────────────────────────────────────────────────
# FridgeAI Backend Environment Variables
# ─────────────────────────────────────────────────────────────

# AI Key Pools (comma-separated for multi-key rotation and failover)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
OPENROUTER_API_KEYS=your_openrouter_key_1,your_openrouter_key_2
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Single key aliases (optional fallbacks)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# AI Model Overrides (Optional - defaults shown below)
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BACKUP_MODEL=llama-3.1-8b-instant

# Set to true to bypass AI network calls and return deterministic mock data
MOCK_AI=true
